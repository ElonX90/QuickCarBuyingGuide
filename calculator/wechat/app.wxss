page { background: #f7f5ed; color: #243f36; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 28rpx; line-height: 1.6; }
view, text, input, button { box-sizing: border-box; }
button { margin: 0; font-size: 28rpx; line-height: 1.45; border-radius: 20rpx; }
button::after { border: 0; }
button[disabled] { opacity: .45; }
